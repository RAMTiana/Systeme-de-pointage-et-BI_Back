# ==============================================================
# Configuration — Backend SRB Haute Matsiatra
# Copier ce fichier en ".env" et adapter les valeurs
# ==============================================================

# --- Application ---
APP_NAME="SRB Haute Matsiatra - API"
APP_ENV=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Base de données PostgreSQL ---
POSTGRES_USER=srb_user
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=srb_haute_matsiatra
# Construite automatiquement dans config.py si DATABASE_URL n'est pas fournie
# DATABASE_URL=postgresql+psycopg2://srb_user:changeme@localhost:5432/srb_haute_matsiatra

# --- Sécurité / JWT (utilisé au module suivant) ---
SECRET_KEY=change-me-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (frontend Angular) ---
CORS_ORIGINS=http://localhost:4200, http://127.0.0.1:4200

# --- WebAuthn (nouvelle ligne à ajouter, absente du template) ---
WEBAUTHN_ORIGIN=http://127.0.0.1:4200

# --- Authentification Google (Sign-In) ---
# Client ID OAuth2 créé dans la console Google Cloud pour ce projet.
# Tant qu'il n'est pas renseigné, POST /api/v1/auth/google répond 501.
# Doit être strictement identique au googleClientId du frontend (environment.ts).
GOOGLE_CLIENT_ID=689643947131-iucmm8a59hg4jki1e56bov5hg1uk9t76.apps.googleusercontent.com

# --- Poste de pointage (module Pointage) ---
# Clé partagée envoyée par le kiosque/dispositif de pointage en en-tête
# `X-Device-Key` sur POST /pointage/qr, /pointage/badge, /pointage/facial.
# Un agent n'ayant pas de compte utilisateur JWT, ces endpoints ne peuvent
# pas être protégés par le RBAC habituel.
DEVICE_API_KEY=change-me-device-key

# --- Job planifié (module Anomalies — détection des absences) ---
# Clé partagée envoyée par l'ordonnanceur externe (cron) en en-tête
# `X-Job-Key` sur POST /api/v1/anomalies/detecter-absences.
JOB_API_KEY=change-me-job-key

# --- Alertes hiérarchiques (module Anomalies — Processus 3) ---
# Email : connecteur SMTP. Tant que SMTP_HOST n'est pas renseigné, les
# alertes email sont consignées avec statut 'echec' (pas d'envoi simulé).
#
# Fournisseur retenu : Brevo (ex-Sendinblue) — relais SMTP transactionnel.
# 1. Créer un compte sur https://www.brevo.com puis valider l'expéditeur
#    (Paramètres > Expéditeurs & domaines) à l'adresse utilisée dans
#    SMTP_FROM_EMAIL ci-dessous (sinon Brevo rejette l'envoi).
# 2. Générer une clé SMTP dans Paramètres > SMTP & API > Clés SMTP.
#    SMTP_USER = l'email de connexion au compte Brevo (PAS la clé).
#    SMTP_PASSWORD = la clé SMTP générée (PAS le mot de passe du compte).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=b41f3e001@smtp-brevo.com
SMTP_PASSWORD=your-smtp-key-here
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=zftiana14@gmail.com

# SMS : passerelle générique par webhook HTTP (à brancher lors du
# déploiement). Tant que SMS_WEBHOOK_URL n'est pas renseigné, aucune alerte
# SMS n'est tentée. Les numéros de la hiérarchie se configurent en base via
# le paramètre système "telephone_hierarchie" (liste séparée par virgules),
# pas ici.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_API_KEY=
