# ==============================================================
# Configuration PRODUCTION — Backend SRB Haute Matsiatra
# ==============================================================
# Copier en ".env" sur le serveur de production UNIQUEMENT (ne jamais
# committer ce fichier une fois rempli). Générer les secrets avec
# ./scripts/generate_secrets.sh puis remplacer chaque "CHANGE_ME_...".
#
# Rappel : app/core/config.py refuse de démarrer si APP_ENV=production et
# qu'une valeur sensible est restée à sa valeur de développement — c'est
# volontaire, ne pas contourner.

# --- Application ---
APP_NAME="SRB Haute Matsiatra - API"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Base de données PostgreSQL ---
POSTGRES_USER=srb_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=srb_haute_matsiatra

# --- Sécurité / JWT ---
# 48+ octets aléatoires, jamais réutilisé d'un environnement à l'autre.
SECRET_KEY=CHANGE_ME_RANDOM_48B_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=srb-haute-matsiatra
JWT_AUDIENCE=srb-frontend

# --- Politique mot de passe ---
PASSWORD_MIN_LENGTH=12

# --- Verrouillage compte ---
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=900
LOCKOUT_DURATION_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_PASSWORD_RESET=5/minute

# --- Redis (mot de passe obligatoire, jamais exposé hors du réseau docker) ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# --- CORS : UNIQUEMENT le(s) domaine(s) HTTPS réel(s) du frontend ---
CORS_ORIGINS=https://srb.hautematsiatra.mg

# --- Authentification Google Sign-In ---
# Doit être strictement identique au googleClientId du frontend (environment.prod.ts).
GOOGLE_CLIENT_ID=689643947131-iucmm8a59hg4jki1e56bov5hg1uk9t76.apps.googleusercontent.com

# --- Poste de pointage (kiosque) ---
DEVICE_API_KEY=CHANGE_ME_RANDOM_32B_DEVICE_KEY

# --- Job planifié (détection des absences, cron externe) ---
JOB_API_KEY=CHANGE_ME_RANDOM_32B_JOB_KEY

# --- SMTP (alertes hiérarchiques par email) ---
# Fournisseur : Brevo (ex-Sendinblue). SMTP_USER = email de connexion Brevo,
# SMTP_PASSWORD = clé SMTP générée dans Brevo (Paramètres > SMTP & API),
# PAS le mot de passe du compte. Expéditeur (SMTP_FROM_EMAIL) à valider
# dans Brevo > Expéditeurs & domaines avant tout envoi réel.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_BREVO_LOGIN_EMAIL
SMTP_PASSWORD=CHANGE_ME_BREVO_SMTP_KEY
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@srb-hautematsiatra.mg

# --- SMS (webhook) ---
SMS_WEBHOOK_URL=
SMS_WEBHOOK_API_KEY=

# ==============================================================
# Infra (docker-compose.yml) — hors Settings applicatifs
# ==============================================================

# Keycloak est provisionné dans docker-compose.yml mais N'EST PAS intégré
# au backend (aucune référence dans le code applicatif à ce jour).
# Ne PAS activer/exposer ce service tant qu'un module d'intégration SSO
# n'a pas été développé et testé : le laisser tourner sans usage réel
# n'apporte qu'une surface d'attaque supplémentaire (voir README).
# Si vous prévoyez de l'utiliser prochainement, changez au minimum ces
# identifiants par défaut avant tout démarrage, même en interne :
KEYCLOAK_ADMIN=CHANGE_ME_ADMIN_LOGIN
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_KEYCLOAK_PASSWORD
KEYCLOAK_HOSTNAME=localhost

# --- Reverse proxy TLS (docker-compose.prod.yml / Traefik) ---
DOMAIN_API=api.srb.hautematsiatra.mg
DOMAIN_FRONT=srb.hautematsiatra.mg
ACME_EMAIL=admin@srb-hautematsiatra.mg
